<table>
    <thead>
        <tr>
            <th class="sorted" onclick="document.location.replace('?SORT=DATE');">Дата (№Докумета) </th>

            <th class="sorted" onclick="document.location.replace('?SORT=MATHERIAL');">Марка стали</th>
            <th class="sorted" onclick="document.location.replace('?SORT=TIKN');">толщина</th>
            <th class="sorted" onclick="document.location.replace('?SORT=WIDTH');">ширина</th>
            <th class="sorted" onclick="document.location.replace('?SORT=HEIGTH');">высота</th>
            <th class="sorted" onclick="document.location.replace('?SORT=QTY');">кол-во</th>
            <th>Программа/<br />владелец</th>
        </tr>
    </thead>
    <tbody>
        @{
            int ogg = 1;
            int oggh = 1;
            foreach (var x in ViewBag.Sheets)
            {
                if (x.Name == "")
                {
                    ogg = 1 - ogg;
                    <tr class="alwaysshowrow_@ogg">
                        <td>
                            @x.Date.ToString("dd/MM/yy").Replace("/", ".") (@x.Document)
                            @if ((ViewBag.User.Privilegies & 16) != 0)
                            {<a><img src="~/img/edit.png" onclick='editSheetArrival(le,lq,"@x.Date.ToString("dd/MM/yy").Replace("/", ".")","@x.Document.Trim()",@x.Tickness,@x.Matherial,@x.Width,@x.Heigth,@x.Quantity,"@x.Owner")' , style="margin-left:10px;"></a>}
                        </td>
                        <td>@ViewBag.m[x.Matherial]</td>
                        <td>@x.Tickness</td>
                        <td>@x.Width</td>
                        <td>@x.Heigth</td>
                        <td>@x.Quantity</td>
                        <td>@x.Owner</td>
                    </tr>
                }
                else
                {
                    ogg = 1 - ogg;
                    <tr class="hiddenrow_@ogg">
                        <td>
                            @x.Date.ToString("dd/MM/yy").Replace("/", ".") (@x.Document)
                            @if ((ViewBag.User.Privilegies & 16) != 0)
                            {<a><img src="~/img/edit.png" onclick='editSheetArrival(le,"@x.Date.ToString("dd/MM/yy").Replace("/", ".")","@x.Document.Trim()",@x.Tickness,@x.Matherial,@x.Width,@x.Heigth,@x.Quantity,"@x.Owner")' , style="margin-left:10px;"></a>}
                        </td>
                        <td>@ViewBag.m[x.Matherial]</td>
                        <td>@x.Tickness</td>
                        <td>@x.Width</td>
                        <td>@x.Heigth</td>
                        <td>@x.Quantity</td>
                        <td>@x.Name</td>
                    </tr>
                }
            }

        }
    </tbody>
</table>
