@{
    ViewBag.Title = "Отгрузки";
}
<div class="row">
    <div class="col-sm-6">

    </div>
    <div class="col-sm-6">
        <input class="form-control" id="myInput" type="text" placeholder="Search..">
    </div>
</div>
<div class="container">
    <h2>Отгрузки</h2>
    <table class="table table-striped table-bordered table-sm table-hover table-responsive">
        <thead>
            <tr>
                <th>№</th>
                <th>Заказ</th>
                <th>дата</th>
                <th>Список позиций</th>
                <th>Всего деталей</th>
            </tr>
        </thead>
        <tbody id="myTable">
            @foreach (var x in ViewBag.shipments)
            {
                <tr>
                    <td>@x.id</td>
                    <td><a href="PartialShip?Name=@x.orderName" />@x.orderName</td>
                    <td>@x.Shiptime.ToString("dd/MM/yy").Replace("/", ".")</td>
                    <td>@x.partId</td>
                    <td>@x.Shiped</td>
                </tr>
            }
        </tbody>
    </table>

</div>