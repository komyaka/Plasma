@* ==========================================================================
   _LayoutMenu.cshtml — Главное навигационное меню приложения
   Отображает пункты меню в зависимости от привилегий текущего пользователя.
   Привилегии проверяются через побитовое И (&) с кодом раздела.
   ========================================================================== *@

<div class="navbar navbar-inverse navbar-fixed-top">
    <div class="container">
        <div class="navbar-header">
            @* Кнопка-гамбургер для мобильных устройств *@
            <button type="button" class="navbar-toggle" data-toggle="collapse" data-target=".navbar-collapse">
                <span class="icon-bar"></span>
                <span class="icon-bar"></span>
                <span class="icon-bar"></span>
            </button>
            @Html.ActionLink("PLASMA", "About", "Home", new { area = "" }, new { @class = "navbar-brand" })
        </div>
        <div class="navbar-collapse collapse">
            <ul class="nav navbar-nav">
                @* Пункт «Программы» — доступен при привилегии 2 (управление программами) *@
                @if (((ViewBag.User.Privilegies & 2) != 0))
                {
                    <li>@Html.ActionLink("Программы", "Index", "Home")</li>
                }
                @* Пункт «Детали» — доступен при привилегии 4 (управление деталями) *@
                @if (((ViewBag.User.Privilegies & 4) != 0))
                {
                    <li>@Html.ActionLink("Детали", "Parts", "Home")</li>
                }
                @* Выпадающее меню «Листы» — доступно при любой из привилегий 8, 16, 32 *@
                @if (((ViewBag.User.Privilegies & 56) != 0))
                {
                    <li class="dropdown">
                        <a href="#" class="dropdown-toggle" data-toggle="dropdown" role="button" aria-expanded="false">Листы <span class="caret"></span></a>
                        <ul class="dropdown-menu" role="menu">
                            @if ((ViewBag.User.Privilegies & 8) != 0)
                            {
                                <li>@Html.ActionLink("Просмотр листов", "Sheets", "Home")</li>
                            }
                            @if ((ViewBag.User.Privilegies & 16) != 0)
                            {
                                <li>@Html.ActionLink("Добавить листы", "NewSheet", "Home")</li>
                                <li>@Html.ActionLink("Приходы металла", "SheetsArrival", "Home")</li>
                            }
                            @if ((ViewBag.User.Privilegies & 32) != 0)
                            {
                                <li>@Html.ActionLink("Отметить порезанные", "MarkSheet", "Home")</li>
                            }
                        </ul>
                    </li>
                }
                @* Пункт «Заказы» — доступен при привилегии 64 *@
                @if ((ViewBag.User.Privilegies & 64) != 0)
                {
                    <li>@Html.ActionLink("Заказы", "CurentOrders", "Home")</li>
                }
                @* Пункт «Отгрузки» — доступен при привилегии 128 *@
                @if ((ViewBag.User.Privilegies & 128) != 0)
                {
                    <li>@Html.ActionLink("Отгрузки", "ViewShip", "SHIPMENT")</li>
                }
                @* Пункт «Пила» — доступен только администратору (32768) *@
                @if ((ViewBag.User.Privilegies & 32768) != 0)
                {
                    <li>@Html.ActionLink("Пила", "CutSaw", "CutSaw")</li>
                }
            </ul>
        </div>
    </div>
</div>
