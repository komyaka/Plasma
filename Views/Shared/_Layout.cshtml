@* ==========================================================================
   _Layout.cshtml — Основной шаблон страницы приложения PLASMA
   Все представления рендерятся внутри @RenderBody().
   Подключает: стили (Bootstrap + Site.css), скрипты (jQuery, AJAX, CNC),
   навигационное меню и футер.
   ========================================================================== *@
<!DOCTYPE html>
<html lang="ru">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>@ViewBag.Title — PLASMA</title>
    @* Подключение стилей: Bootstrap + пользовательские стили *@
    @Styles.Render("~/Content/css")
    @Styles.Render("~/Content/Site.css")
    @* Подключение скриптов: AJAX-запросы, визуализация CNC, показ/скрытие строк *@
    @Scripts.Render("~/Scripts/myAjax.js")
    @Scripts.Render("~/Scripts/PaintCNC.js")
    @Scripts.Render("~/Scripts/ShowHide.js")
    <link rel="shortcut icon" href="~/favicon.ico" type="image/x-icon" />
</head>
<body>
    @* Навигационное меню (зависит от привилегий пользователя) *@
    @RenderPage("_LayoutMenu.cshtml")

    @* Строка уведомления об устаревших данных и текущего времени *@
    <div class="row" style="margin: 5px 15px 0;">
        <div class="col-sm-10">
            <span id="PleaceUpdate" style="display:none">&#9888; Обновите страницу, информация не актуальна</span>
        </div>
        <div class="col-sm-2">
            <span id="Currenttime" style="display:none">@ViewBag.currenttime</span>
        </div>
    </div>

    @* Контейнер для AJAX-ответов (используется myAjax.js) *@
    <p id="Response"></p>

    @* Основной контент страницы *@
    <div class="container body-content">
        @RenderBody()
        <hr />
        @* Нижняя панель (футер) *@
        <div class="navbar navbar-inverse navbar-fixed-bottom">
            <footer>
                <p id="bottomlogo" class="text-center">&copy; ИВАНОВО WEBTECH @DateTime.Now.Year &mdash; Система управления плазменной резкой</p>
            </footer>
        </div>
    </div>

    @* Скрипты загружаются в конце страницы для ускорения рендеринга *@
    @Scripts.Render("~/bundles/jquery")
    @Scripts.Render("~/bundles/bootstrap")
    @RenderSection("scripts", required: false)
    @Scripts.Render("~/bundles/modernizr")
    @Scripts.Render("~/Scripts/filter.js")

    @* Кнопка «Наверх» *@
    <a href="#" class="back-to-top" title="Наверх">&#8679;</a>
</body>
</html>
