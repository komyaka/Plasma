<link rel="stylesheet" type="text/css" href="~/Content/cssworld.ru-xcal.css" />
<script-- type="text/javascript" src="~/Scripts/cssworld.ru-xcal.js"></script>
<script src="https://cdn.jsdelivr.net/npm/vue@2"></script>
@{
    ViewBag.Title = "Добавить листы в базу";
}

<h4>Добавить новый лист</h4>
<div id="NS">
    <form action="~/home/NewSheet2">
        <div>
            Материал
            <select id="matsel" name="mat" v-model="material">
                @{ int matcount = 0;
                    foreach (string M in ViewBag.mt)
                    {
                        if (M.Length > 0)
                        {
                            <option value="@matcount">@M</option>
                        }
                        matcount++;
                    }
                }
            </select>
            <img v-if="!(this.material>0)" src="~/IMG/attent.png" id="nomat" alt="Укажите материал" title="Укажите материал" align="bottom" />
        </div>
        Толщина=
        <select v-model="tickness">
            @{
                foreach (float k in ViewBag.t)
                {
                    <option value="@k.ToString().Replace(",", ".")">@k.ToString().Replace(",", ".")</option>
                }
            }
        </select>
        <p id="massa">{{massa}}</p>
        Размер
        <select id="sizesel" name="Size" v-model="currentSize">
            <option v-for="i in sheetSizes" v-bind:value="i.val">{{i.text}}</option>
        </select>
        <div id="SS" v-show="currentSize==0">
            длина
            <input id="SheetWidth" type="number" v-model="WIDTH" width="3" />
            Ширина
            <input id="SheetHeigth" type="number" v-model="HEIGTH" width="3" />
            <br>
        </div>
        количество
        <input id="QUANTITY" type="number" v-model="Quantity" value="1" />
        <br>
        заказчик
        <input type="TEXT" v-model="OWNER" value="МОНТАЖНИК" />
        <br>
        Документ №
        <input type="TEXT" v-model="DOC" value="" width="3" />
        <br>
        дата
        <input type="text" name="Date" value="@ViewBag.now" size="19" onClick="xCal(this)" onKeyUp="xCal()">
        <input type="submit" value="Добавить в базу" v-show="valideform">
    </form>
</div>
<script>
    var app = new Vue({
        el: '#NS',
        data: {
            sheetSizes: [
                { val: 1, text: '2000x1000' },
                { val: 2, text: "2500x1250" },
                { val: 3, text: "6000x1500" },
                { val: 4, text: "6000x2000" },
                { val: 5, text: "12000x1500" },
                { val: 6, text: "12000x2000" },
                { val: 0, text: "другой" }],
            material: '',
            tickness: 0,
            DOC: '',
            OWNER: 'МОНТАЖНИК',
            Quantity: 1,
            WIDTH: 0,
            HEIGTH: 0,
            othersize: false,
        },
        metods:
        {
            setsize() {
                if (parseFloat(this.tickness) < 3) this.currentSize = "2";
                else this.currentSize = "3";
            }
        },
        computed:
        {
            massa: function () {
                switch (this.currentSize) {
                    case 1: { this.WIDTH = 2000; this.HEIGTH = 1000; return this.WIDTH * this.HEIGTH * parseFloat(this.tickness) * this.Quantity * 7.85 / 1000000; break; }
                    case 2: { this.WIDTH = 2500; this.HEIGTH = 1250; return this.WIDTH * this.HEIGTH * parseFloat(this.tickness) * this.Quantity * 7.85 / 1000000; break; }
                    case 3: { this.WIDTH = 6000; this.HEIGTH = 1500; return this.WIDTH * this.HEIGTH * parseFloat(this.tickness) * this.Quantity * 7.85 / 1000000; break; }
                    case 4: { this.WIDTH = 6000; this.HEIGTH = 2000; return this.WIDTH * this.HEIGTH * parseFloat(this.tickness) * this.Quantity * 7.85 / 1000000; break; }
                    case 5: { this.WIDTH = 12000; this.HEIGTH = 1500; return this.WIDTH * this.HEIGTH * parseFloat(this.tickness) * this.Quantity * 7.85 / 1000000; break; }
                    case 6: { this.WIDTH = 12000; this.HEIGTH = 2000; return this.WIDTH * this.HEIGTH * parseFloat(this.tickness) * this.Quantity * 7.85 / 1000000; break; }
                    default: break;
                }
            },
            currentSize: function () { return parseFloat(this.tickness) < 3 ? 2 : 3 },
            valideform: function () { return ((this.material > 0) && (this.tickness > 0) && (this.DOC != "") & (this.Quantity > 0)) }
        }



    });
</script>